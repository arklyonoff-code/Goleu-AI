# ToolFit 환경변수 예시.
# 실제 키는 .env.local 에 복사해서 입력하세요. (.env.local 은 git ignore)

# Google Analytics 4 Measurement ID (예: G-XXXXXXXXXX)
# GA4 콘솔 → 관리 → 데이터 스트림 → 웹 → '측정 ID' 복사
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Worker URL (AI 추천 API)
# Worker 배포 후 실제 URL로 변경:
#   https://toolfit-api.YOUR-ACCOUNT.workers.dev
# 로컬 개발 시: http://localhost:8787 (wrangler dev 실행 후)
VITE_WORKER_URL=https://toolfit-api.YOUR-ACCOUNT.workers.dev
